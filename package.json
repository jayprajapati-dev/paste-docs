    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "docx-preview": "^0.3.7",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "onnxruntime-web": "1.21.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^2.0.1",
    "react-hot-toast": "^2.6.0",
    "react-konva": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
